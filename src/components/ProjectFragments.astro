---
import { getAllProjects, getProjectContent } from '../lib/projects';

const projects = getAllProjects().map((project) => {
  const content = getProjectContent(project, 'en');
  return {
    title: content.title,
    description: content.description.split('\n\n')[0] ?? content.title,
    image: project.thumbnail,
    href: content.publicationLink,
  };
});
---

<section id="featured-work" class="project-fragments" aria-labelledby="fragments-title">
  <div class="project-fragments__heading">
    <div>
      <h2 id="fragments-title">Fragments</h2>
      <p>Selected projects <span>·</span> {String(projects.length).padStart(2, '0')}</p>
    </div>
    <a href="/projects" class="project-fragments__all">
      See all cases
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg>
    </a>
  </div>

  <div class="project-fragments__track">
    {projects.map((project, index) => (
      <a class="project-fragment" href={project.href} target="_blank" rel="noopener noreferrer">
        <img src={project.image} alt={project.title} loading={index === 0 ? 'eager' : 'lazy'} />
        <span class="project-fragment__caption">
          <span>{project.title}</span>
          <span class="project-fragment__number">{String(index + 1).padStart(2, '0')}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .project-fragments {
    width: min(82%, 1500px);
    margin: 0 auto;
    padding: 0 0 1.15rem;
  }

  .project-fragments__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 0.7rem;
  }

  .project-fragments__heading h2,
  .project-fragments__heading p {
    margin: 0;
  }

  .project-fragments__heading h2 {
    color: #f1f0ed;
    font: 500 0.78rem/1.3 'Syne', sans-serif;
  }

  .project-fragments__heading p,
  .project-fragments__all {
    color: rgba(241, 240, 237, 0.58);
    font: 400 0.52rem/1.5 'DM Mono', monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-fragments__heading p {
    margin-top: 0.22rem;
  }

  .project-fragments__heading p span {
    margin: 0 0.3rem;
    color: rgba(241, 240, 237, 0.34);
  }

  .project-fragments__all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #f1f0ed;
    text-decoration: none;
  }

  .project-fragments__all svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  .project-fragments__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .project-fragment {
    position: relative;
    display: block;
    min-width: 0;
    color: #f1f0ed;
    text-decoration: none;
  }

  .project-fragment img {
    display: block;
    width: 100%;
    height: clamp(5rem, 9.5vh, 7.25rem);
    object-fit: cover;
    object-position: center 22%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.35rem;
    opacity: 0.76;
    transition: opacity 180ms ease, border-color 180ms ease;
  }

  .project-fragment:hover img,
  .project-fragment:focus-visible img {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.42);
  }

  .project-fragment__caption {
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    padding-top: 0.38rem;
    color: rgba(241, 240, 237, 0.8);
    font: 500 0.56rem/1.35 'Syne', sans-serif;
  }

  .project-fragment__number {
    color: rgba(241, 240, 237, 0.48);
    font: 400 0.5rem/1.4 'DM Mono', monospace;
  }

  @media (max-width: 900px) {
    .project-fragments {
      width: min(88%, 42rem);
      padding-bottom: 1rem;
    }

    .project-fragments__track {
      grid-template-columns: repeat(3, minmax(12rem, 1fr));
      overflow-x: auto;
      padding-bottom: 0.3rem;
    }
  }

  @media (max-width: 560px) {
    .project-fragments__track {
      grid-template-columns: repeat(3, minmax(10rem, 1fr));
    }

    .project-fragment img {
      height: 5rem;
    }
  }
</style>
